default_platform :mac

platform :mac do

  ############################ PRE ############################

  before_all do
  end

  ######################## SETUP LANES ########################

  desc "Setup development"
  lane :setup do
  end

  desc "Setup release developer id account settings. (only use admin)"
  lane :setup_release_id do
    # Update Project Team
    update_project_team(
      path: "Clipy.xcodeproj",
      teamid: "BBCHAJ584H"
    )
    # Update Provisioning Profile
    update_provisioning_profile_specifier(
      xcodeproj: "Clipy.xcodeproj",
      new_specifier: "ClipyDistribution",
      configuration: "Release",
      target: "^Clipy$"
    )
  end

  ####################### PUBLIC LANES ########################

  desc "Runs all the tests"
  lane :test do
    scan_clipy
  end

  desc "Build DMG for Release"
  lane :build_dmg do
    # Define absolute paths to avoid confusion
    # '..' goes up from fastlane/ directory to project root
    build_dir = File.absolute_path("../build")
    
    # Build the app using Gym
    # Using local self-signed certificate for proper accessibility permissions
    gym(
      scheme: "Clipy",
      workspace: "Clipy.xcworkspace",
      clean: true,
      configuration: "Release",
      output_directory: build_dir,
      output_name: "Clipy-AppleSilicon",
      skip_package_ipa: true,
      skip_profile_detection: true,
      export_method: "mac-application",
      include_bitcode: false,
      # Use the specific self-signed certificate name created by the user
      xcargs: "CODE_SIGN_IDENTITY='ClipySelfSign' CODE_SIGNING_REQUIRED=YES CODE_SIGNING_ALLOWED=YES PROVISIONING_PROFILE_SPECIFIER=''",
      export_options: {
        method: "mac-application",
        signingStyle: "manual",
        teamID: "", # No team ID needed for self-signing
        signingCertificate: "ClipySelfSign" # Explicitly use the certificate
      }
    )

    # Create DMG
    dmg_path = "#{build_dir}/Clipy-AppleSilicon.dmg"
    app_path = "#{build_dir}/Clipy-AppleSilicon.app"
    
    # Remove existing DMG if any
    sh "rm -f '#{dmg_path}'"
    
    # Create DMG using hdiutil
    # Use single quotes to handle spaces in volume name
    sh "hdiutil create -volname 'Clipy Apple Silicon' -srcfolder '#{app_path}' -ov -format UDZO '#{dmg_path}'"
    
    UI.message("DMG created successfully at #{dmg_path}")
  end
  
  desc "Release"
  lane :release do
    # TODO: Use :codesigning_identity options (Developer ID Application: Shunsuke Furubayashi (BBCHAJ584H))
    # TODO: Use :export_method options (developer-id)
  end

  ####################### PRIVATE LANES ########################

  private_lane :scan_clipy do
    scan(
      workspace: "Clipy.xcworkspace",
      scheme: "Clipy",
      skip_build: true,
      verbose: true,
      clean: true
    )
  end

  ############################ POST ############################

  after_all do |lane|
  end

  error do |lane, exception|
  end
end