    "Beta feature settings may not be preserved after an update." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen für Beta-Funktionen werden nach einem Update möglicherweise nicht beibehalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni delle funzionalità beta potrebbero non essere mantenute dopo un aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベータ機能はバージョンアップ後に設定を引き継がない可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações dos recursos beta podem não ser mantidas após uma atualização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试功能的设置可能不会在版本更新后保留。"
          }
        }
      }
    },
    "Changes take effect the next time Clipy launches. Usage logs do not include personal information or copied content." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は、次回のClipy起動時に反映されます。使用状況ログに個人情報やコピー内容は含まれません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen werden beim nächsten Start von Clipy wirksam. Nutzungsprotokolle enthalten keine personenbezogenen Daten oder kopierten Inhalte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche avranno effetto al prossimo avvio di Clipy. I registri di utilizzo non includono informazioni personali né contenuti copiati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações entram em vigor na próxima vez que o Clipy for iniciado. Os registros de uso não incluem informações pessoais nem conteúdo copiado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改将在下次启动 Clipy 时生效。使用日志不包含个人信息或复制的内容。"
          }
        }
      }
    },
