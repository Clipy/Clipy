{
  "sourceLanguage" : "en",
  "strings" : {
    "Add a menu item to clear clipboard history" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüeintrag zum Löschen des Verlaufs hinzufügen"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una voce di menu per cancellare la cronologia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴をクリアするメニュー項目を追加"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar um item de menu para limpar o histórico"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加清空历史记录的菜单项"
          }
        }
      }
    },
    "Additional history is grouped into folders. Set to 0 to group all history into folders." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この件数を超える履歴はフォルダにまとめます。0にすると、すべての履歴をフォルダにまとめます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Verlaufseinträge werden in Ordnern gruppiert. Bei 0 werden alle Einträge in Ordnern gruppiert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci oltre questo limite vengono raggruppate in cartelle. Imposta 0 per raggruppare tutte le voci in cartelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens que excederem esse limite serão agrupados em pastas. Defina como 0 para agrupar todo o histórico em pastas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出此数量的历史记录将归入文件夹。设为 0 时，所有历史记录都将归入文件夹。"
          }
        }
      }
    },
    "Automatically check for updates" : {
