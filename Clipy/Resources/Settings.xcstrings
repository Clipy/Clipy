    "firstItemHighlightDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, springt die Taste „Pfeil nach oben“ zum letzten Eintrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off to let the Up Arrow key move to the last item."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن را غیرفعال کنید تا بتوانید با کلید جهت‌نمای بالا به آخرین مورد بروید."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva per poter passare all’ultima voce con il tasto Freccia su."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、上矢印キーで一番下の項目に移動できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative para que a tecla de seta para cima leve ao último item."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть, щоб клавішею зі стрілкою вгору можна було перейти до останнього пункту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，按上箭头键可移到最后一项。"
          }
        }
      }
    },
    "historyClearIntervalDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den gesamten Verlauf im gewählten Zeitabstand, solange Clipy läuft. Textbausteine werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears all history at the selected interval while Clipy is running. Snippets are not deleted."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حین اجرای Clipy، تمام تاریخچه در بازهٔ زمانی انتخاب‌شده پاک می‌شود. قطعه‌متن‌ها حذف نمی‌شوند."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella tutta la cronologia all’intervallo selezionato mentre Clipy è in esecuzione. I frammenti non vengono eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動中、指定した間隔で履歴全体を削除します。スニペットは削除されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa todo o histórico no intervalo selecionado enquanto o Clipy estiver em execução. Os trechos não são excluídos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищає всю історію через вибраний інтервал, поки Clipy працює. Фрагменти не видаляються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipy 运行期间，按所选间隔清除全部历史记录。片段不会被删除。"
          }
        }
      }
    },
