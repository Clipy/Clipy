    "Add a menu item to clear clipboard history" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüeintrag zum Löschen des Verlaufs hinzufügen"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افزودن گزینه‌ای به منو برای پاک کردن تاریخچهٔ کلیپ‌بورد"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una voce di menu per cancellare la cronologia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴をクリアするメニュー項目を追加"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar um item de menu para limpar o histórico"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати пункт очищення історії"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加清空历史记录的菜单项"
          }
        }
      }
    },
    "Add an app to stop saving its clipboard history." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Apps hinzu, deren Zwischenablage nicht im Verlauf gespeichert werden soll."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک برنامه اضافه کنید تا ذخیرهٔ تاریخچهٔ کلیپ‌بورد آن متوقف شود."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le app di cui non vuoi salvare gli appunti nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴に保存したくないアプリを追加してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione os apps cujo conteúdo copiado não deve ser salvo no histórico."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте програми, вміст буфера обміну яких не слід зберігати в історії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加不希望保存其剪贴板历史记录的 App。"
          }
        }
      }
    },
    "Additional history is grouped into folders. Set to 0 to group all history into folders." : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخچهٔ اضافی در پوشه‌ها گروه‌بندی می‌شود. برای گروه‌بندی تمام تاریخچه در پوشه‌ها، آن را روی 0 تنظیم کنید."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この件数を超える履歴はフォルダにまとめます。0にすると、すべての履歴をフォルダにまとめます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Verlaufseinträge werden in Ordnern gruppiert. Bei 0 werden alle Einträge in Ordnern gruppiert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci oltre questo limite vengono raggruppate in cartelle. Imposta 0 per raggruppare tutte le voci in cartelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens que excederem esse limite serão agrupados em pastas. Defina como 0 para agrupar todo o histórico em pastas."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решта історії групується в папки. Установіть 0, щоб згрупувати всю історію в папки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出此数量的历史记录将归入文件夹。设为 0 时，所有历史记录都将归入文件夹。"
          }
        }
      }
    },
