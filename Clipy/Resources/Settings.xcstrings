    "To keep Settings accessible even if you cannot open the menu, this shortcut can be changed but cannot be removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Sie die Einstellungen auch dann öffnen können, wenn sich das Menü nicht mehr öffnen lässt, kann dieser Kurzbefehl geändert, aber nicht entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To keep Settings accessible even if you cannot open the menu, this shortcut can be changed but cannot be removed."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای در دسترس ماندن تنظیمات حتی اگر نتوانید منو را باز کنید، این میانبر قابل تغییر است اما قابل حذف نیست."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per consentire di aprire le impostazioni anche quando non è possibile aprire il menu, questa scorciatoia può essere modificata, ma non rimossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューが開けなくなっても設定を開けるようにするため、このショートカットは変更できますが、削除できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que você possa abrir os ajustes mesmo quando não conseguir abrir o menu, este atalho pode ser alterado, mas não removido."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб ви могли відкрити налаштування, навіть якщо меню не відкривається, це клавіатурне скорочення можна змінити, але не можна видалити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为确保菜单无法打开时仍能打开设置，此快捷键可以更改，但不能删除。"
          }
        }
      }
    },
